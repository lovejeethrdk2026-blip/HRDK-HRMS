PORT=3030

MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173

# Signs the login session cookie (config/session.js). Any long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# COSEC data source: the database the external COSEC sync writes raw punches
# and the employee master into. Same cluster and credentials as MONGO_URI,
# read-only for this app (its own data stays in MONGO_URI's database).
COSEC_DB_NAME=COSEC-ATTENDANCE
# That sync stores reader wall-clock (IST) times labelled as UTC, so "UTC"
# yields correct local times. Use Asia/Kolkata only if it is fixed to store real UTC.
PUNCH_TIME_ZONE=UTC
# Taps within this many seconds of the previous kept punch are the same punch.
PUNCH_DUPLICATE_SECONDS=120
# Rebuild this many trailing days on each run, and run this often.
# Minutes of already-synced punch rows each incremental run re-reads (a window
# on when the COSEC puller wrote them, not on when the punch happened).
COSEC_SYNC_OVERLAP_MINUTES=30
COSEC_SYNC_MINUTES=5

# The Pay Sheet app (paysheet-app/backend). The admin panel Pay Sheet 1/2/3
# pages are relayed from it through /api/paysheets.
PAYSHEET_API_URL=http://localhost:4050
# Folder of that backend (the one with its server.js). When set, this server
# starts it automatically if nothing answers at PAYSHEET_API_URL, and checks
# again every minute. Leave empty to start the Pay Sheet app yourself.
# PAYSHEET_APP_DIR=C:\Users\you\Desktop\paysheet-app\backend
