# Copy this file to `.env` and fill in real values. Never commit `.env`
# itself — see .gitignore.

# Set this in production. src/app.js's error handler already never leaks
# stack traces/paths regardless, but Express itself (and some libraries)
# still change behavior based on this — leave unset for local development.
NODE_ENV=production

# Port and interface this server listens on. Behind the HRDK dashboard the
# dashboard backend forwards /orders/* to 127.0.0.1:3000 (its ORDERS_UPSTREAM).
# Keep HOST on loopback: this app has no login of its own.
PORT=3000
HOST=127.0.0.1

# Comma-separated allow-list of frontend origins. Any private-LAN IP on a
# Vite dev port (5173-5179) is also auto-allowed by src/app.js.
CORS_ORIGIN=http://localhost:3001

MONGO_URI=mongodb://127.0.0.1:27017/order-application

# Dynamics 365 Business Central — supplier (vendor) list for EF Designs.
# Leave unset if BC365 isn't used; that integration just stays disabled.
BC365_TENANT_ID=
BC365_ENVIRONMENT=
BC365_COMPANY_ID=
BC365_CLIENT_ID=
BC365_CLIENT_SECRET=

# Google Drive — EF Design > Design Media > CAD File storage (MOVED here
# from Master Data > Die Number > CAD), using OAuth 2.0 against a personal
# Google account (uploaded files count against that account's own Google One
# storage). See GOOGLE_DRIVE_SETUP.md for the full Google Cloud setup and how
# to connect an account.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from a Google Cloud OAuth
# Client ID (Desktop or Web application type — see GOOGLE_DRIVE_SETUP.md).
# GOOGLE_REDIRECT_URI must exactly match a redirect URI registered on that
# OAuth client. Locally that is the dashboard dev server's /orders/ address,
# which forwards through the dashboard backend's gate.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://sales.hrdk.in/orders/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/orders/auth/google/callback

# GOOGLE_DRIVE_FOLDER_ID is the target folder's id (the part of its Drive
# URL after /folders/) — a folder you create by hand in your own personal
# Google Drive. Not a secret, just an identifier.
GOOGLE_DRIVE_FOLDER_ID=

# Separate Drive folder for ordinary application images (Category, Brand, EF
# Design, Order, ...). Never the same folder as GOOGLE_DRIVE_FOLDER_ID (CAD only).
GOOGLE_DRIVE_IMAGE_FOLDER_ID=

# Separate Drive folder for CRM > Direct Customer images only. Required only
# when a Direct Customer image is uploaded (no fallback to the folder above).
GOOGLE_DRIVE_DIRECT_CUSTOMER_FOLDER_ID=

# Separate Drive folders for Inventory > Ready Stock and Inventory > Temporary
# Stock images (e.g. "HRDK Ready Stock Images", "HRDK Temporary Stock
# Images"). Images go straight into the folder — no subfolder. Required only
# when such an image is uploaded (no fallback to the shared folder above).
# Images uploaded before these existed stay where they are and keep working.
GOOGLE_DRIVE_READY_STOCK_FOLDER_ID=
GOOGLE_DRIVE_TEMPORARY_STOCK_FOLDER_ID=

# Encrypts the stored OAuth refresh token at rest in MongoDB (see
# utils/tokenCrypto.js). Any string works; generate one with:
#   openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional — max CAD file size in MB (default 50 if unset).
MAX_CAD_FILE_MB=50

# Optional — Category/Brand/Collection/Gender/ItemGroup/SubCategory/EFDesign
# image upload limits (defaults shown).
MAX_IMAGE_MB=5
MAX_IMAGE_FILES=20
MAX_EFDESIGN_GALLERY_IMAGES=20
MAX_ORDER_IMAGE_MB=5
# most new images (all items' Client Images + order images) in one Order save
MAX_ORDER_IMAGE_FILES=50
# Order item Client Video (one per item): max size in MB, and most new
# videos in one Order save (each is held in memory until the save ends)
MAX_ORDER_VIDEO_MB=100
MAX_ORDER_VIDEO_FILES=5
MAX_DESIGN_VIDEO_MB=100

# Google Drive for employee documents (see Users page > Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/drive/callback
# Optional; leave empty and the app makes the hrdk-hrms folder itself
GOOGLE_DRIVE_FOLDER_ID=
# Any long random text; locks the saved Google token
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Employee app: Employee-ID-only login (temporary, office network only). 1 = on.
EMP_APP_ID_LOGIN=0
