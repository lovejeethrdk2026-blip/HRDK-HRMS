{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3030
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ADMIN",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "emp-app-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd HRDK-EMP-APP && npx expo start --web --port 8090"
      ],
      "port": 8090
    }
  ]
}
