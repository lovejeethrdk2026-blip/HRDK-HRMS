# Where the admin app sends API calls.
# "/api" = same host (dev: Vite proxies to http://localhost:3030, see vite.config.js).
# For a build talking to another server, put the full URL, e.g.
# VITE_API_URL=https://hrdk-hrms.onrender.com/api
# Restart `npm run dev` (or rebuild) after changing this.
VITE_API_URL=/api
